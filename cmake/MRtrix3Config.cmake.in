# Build-tree package configuration for MRtrix3 (generated by CMake; do not edit).
#
# Lets an external project build against this MRtrix3 build + source tree:
#     find_package(MRtrix3 CONFIG REQUIRED PATHS <this build directory> NO_DEFAULT_PATH)
#
# This is a *build-tree* package (it references absolute paths into this build and source tree); it
# is NOT a relocatable installation package.

include(CMakeFindDependencyMacro)

# Make MRtrix3's own CMake modules (e.g. FindFFTW) available to recreate imported dependency targets.
list(APPEND CMAKE_MODULE_PATH "@MRTRIX_SOURCE_CMAKE_DIR@")

# Imported dependencies referenced by the exported MRtrix3 targets, recreated in the consumer.
find_dependency(Threads)
find_dependency(ZLIB)
@MRTRIX_CONFIG_FIND_DEPS@
include(FindFFTW)   # (re)creates the fftw3::fftw imported target

include("${CMAKE_CURRENT_LIST_DIR}/MRtrix3Targets.cmake")
