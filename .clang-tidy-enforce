Checks: >
  -*,
  -cpp/core/eigen_plugins/*,
  -cpp/gui/opengl/gl_core_3_3.*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  performance-*,
  readability-implicit-bool-conversion,
  readability-container-size-empty,
  readability-redundant-casting,
  readability-else-after-return,
  readability-uppercase-literal-suffix,
  modernize-use-auto,
  modernize-use-emplace,
  modernize-loop-convert,
  modernize-make-unique,
  modernize-make-shared,
  modernize-use-nodiscard,
  modernize-use-using,
  # misc-const-correctness -- not enforced; conflicts with ThreadedLoop functor idiom (non-const operator()). See commit body.,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  -clang-analyzer-unix.Malloc,
  # performance-* sub-checks excluded: large residuals with no safe autofix or conflicts with house rules,
  -performance-enum-size,
  -performance-unnecessary-value-param,
  -performance-move-constructor-init,
  -performance-no-int-to-ptr,
  -performance-type-promotion-in-math-fn,
  -performance-no-automatic-move,
WarningsAsErrors: '*'
HeaderFilterRegex: '(cpp\/|testing\/(lib\/|tools\/|unit_tests\/)).*\.(h|hpp)'
#ExcludeHeaderFilterRegex: '(_deps\/|cpp\/core\/eigen_plugins\/|cpp\/gui\/opengl\/gl_core_3_3).*'
