#!/bin/bash
# Multiple tests for the C++ binary command-line interface

# Test using all options at once
trap "rm -rf tmp-dirin/ tmp-filein.txt tmp-tracksin.tck" EXIT; \
    mkdir -p tmp-dirin/ \
    && touch tmp-filein.txt \
    && touch tmp-tracksin.tck \
    && testing_cpp_cli \
        -flag \
        -text my_text \
        -choice One \
        -bool false \
        -int_unbound 0 \
        -int_nonneg 1 \
        -int_bound 50 \
        -float_unbound 0.0 \
        -float_nonneg 1.0 \
        -float_bound 0.5 \
        -int_seq 1,2,3 \
        -float_seq 0.1,0.2,0.3 \
        -dir_in tmp-dirin/ \
        -dir_out tmp-dirout/ \
        -file_in tmp-filein.txt \
        -file_out tmp-fileout.txt \
        -tracks_in tmp-tracksin.tck \
        -tracks_out tmp-tracksout.tck \
        -any my_any

# Run previous with different option/argument orders
trap "rm -rf tmp-dirin/ tmp-filein.txt tmp-tracksin.tck" EXIT; \
    mkdir -p tmp-dirin/ \
    && touch tmp-filein.txt \
    && touch tmp-tracksin.tck \
    && testing_cpp_cli \
        -text my_text \
        -choice One \
        -bool false \
        -int_unbound 0 \
        -int_nonneg 1 \
        -int_bound 50 \
        -float_unbound 0.0 \
        -float_nonneg 1.0 \
        -float_bound 0.5 \
        -int_seq 1,2,3 \
        -float_seq 0.1,0.2,0.3 \
        -dir_in tmp-dirin/ \
        -dir_out tmp-dirout/ \
        -file_in tmp-filein.txt \
        -file_out tmp-fileout.txt \
        -tracks_in tmp-tracksin.tck \
        -tracks_out tmp-tracksout.tck \
        -any my_any \
        -flag
trap "rm -rf tmp-dirin/ tmp-filein.txt tmp-tracksin.tck" EXIT; \
    mkdir -p tmp-dirin/ \
    && touch tmp-filein.txt \
    && touch tmp-tracksin.tck \
    && testing_cpp_cli \
        -choice One \
        -bool false \
        -int_unbound 0 \
        -int_nonneg 1 \
        -int_bound 50 \
        -float_unbound 0.0 \
        -float_nonneg 1.0 \
        -float_bound 0.5 \
        -int_seq 1,2,3 \
        -float_seq 0.1,0.2,0.3 \
        -dir_in tmp-dirin/ \
        -dir_out tmp-dirout/ \
        -file_in tmp-filein.txt \
        -file_out tmp-fileout.txt \
        -tracks_in tmp-tracksin.tck \
        -tracks_out tmp-tracksout.tck \
        -any my_any \
        -flag \
        -text my_text
trap "rm -rf tmp-dirin/ tmp-filein.txt tmp-tracksin.tck" EXIT; \
    mkdir -p tmp-dirin/ \
    && touch tmp-filein.txt \
    && touch tmp-tracksin.tck \
    && testing_cpp_cli \
        -bool false \
        -int_unbound 0 \
        -int_nonneg 1 \
        -int_bound 50 \
        -float_unbound 0.0 \
        -float_nonneg 1.0 \
        -float_bound 0.5 \
        -int_seq 1,2,3 \
        -float_seq 0.1,0.2,0.3 \
        -dir_in tmp-dirin/ \
        -dir_out tmp-dirout/ \
        -file_in tmp-filein.txt \
        -file_out tmp-fileout.txt \
        -tracks_in tmp-tracksin.tck \
        -tracks_out tmp-tracksout.tck \
        -any my_any \
        -flag \
        -text my_text \
        -choice One

# No arguments are supported
! testing_cpp_cli random_arg

# Test export of interface to various file formats
trap "rm -f tmp.txt" EXIT; \
    testing_cpp_cli -help | \
    tail -n +3 | \
    diff -a --strip-trailing-cr - cpp_cli/help.txt
trap "rm -f tmp.txt" EXIT; \
    testing_cpp_cli __print_full_usage__ | \
    diff -a --strip-trailing-cr - cpp_cli/full_usage.txt
trap "rm -f tmp.md" EXIT; \
    testing_cpp_cli __print_usage_markdown__ | \
    diff -a --strip-trailing-cr - cpp_cli/markdown.md
trap "rm -f tmp.rst" EXIT; \
    testing_cpp_cli __print_usage_rst__ | \
    diff -a --strip-trailing-cr - cpp_cli/restructured_text.rst

# Test suitable handling of valid and invalid inputs to various argument types
testing_cpp_cli -bool false
testing_cpp_cli -bool False
testing_cpp_cli -bool FALSE
testing_cpp_cli -bool true
testing_cpp_cli -bool True
testing_cpp_cli -bool TRUE
testing_cpp_cli -bool 0
testing_cpp_cli -bool 1
testing_cpp_cli -bool 2
! testing_cpp_cli -bool NotABool
! testing_cpp_cli -int_unbound 0.1
! testing_cpp_cli -int_unbound NotAnInt
! testing_cpp_cli -int_nonneg -1
! testing_cpp_cli -int_bound 101
! testing_cpp_cli -float_unbound NotAFloat
! testing_cpp_cli -float_nonneg -0.1
! testing_cpp_cli -float_bound 1.1
! testing_cpp_cli -int_seq 0.1,0.2,0.3
! testing_cpp_cli -int_seq Not,An,Int,Seq
! testing_cpp_cli -float_seq Not,A,Float,Seq

# Multi-spelling option / choice-value aliases (spelling-design.md; the Python parser mirrors this).
# The canonical "-choice" option also answers to the alias "-choose", and the choice value "one"
#   additionally accepts the alias spelling "uno"; both resolve to the canonical value that is the
#   sole spelling shown in help and every machine-readable export.
# Canonical spelling of both the option and the choice value.
testing_cpp_cli -choice one 2>&1 | grep "choice: one"
# Full alias spelling of the option resolves to the canonical option.
testing_cpp_cli -choose one 2>&1 | grep "choice: one"
# A prefix shared by the canonical name and the alias collapses to the one option (no spurious
#   "several matches"): "-cho" prefixes both "choice" and "choose", which are the same option.
testing_cpp_cli -cho one 2>&1 | grep "choice: one"
# A prefix specific to the canonical name, and one specific to the alias, each resolve.
testing_cpp_cli -choic one 2>&1 | grep "choice: one"
testing_cpp_cli -choos one 2>&1 | grep "choice: one"
# The choice-value alias "uno" is canonicalised to "one" at parse time, via either option spelling.
testing_cpp_cli -choice uno 2>&1 | grep "choice: one"
testing_cpp_cli -choose uno 2>&1 | grep "choice: one"
# An unknown choice value is still rejected (the alias adds a spelling, it does not relax validation).
! testing_cpp_cli -choice NotAChoice

# Integer suffix multipliers on scalar integer types (ParsedArgument::as_int(); decimal
#   multipliers k/K=1e3, m/M=1e6, b/B=1e9, t/T=1e12).
# Each multiplier, upper and lower case.
testing_cpp_cli -int_unbound 5k 2>&1 | grep "int_unbound: 5000"
testing_cpp_cli -int_unbound 5K 2>&1 | grep "int_unbound: 5000"
testing_cpp_cli -int_unbound 3m 2>&1 | grep "int_unbound: 3000000"
testing_cpp_cli -int_unbound 3M 2>&1 | grep "int_unbound: 3000000"
# "b"/"B" is a decimal billion (1e9), NOT a bytes multiplier.
testing_cpp_cli -int_unbound 2b 2>&1 | grep "int_unbound: 2000000000"
testing_cpp_cli -int_unbound 2B 2>&1 | grep "int_unbound: 2000000000"
testing_cpp_cli -int_unbound 1t 2>&1 | grep "int_unbound: 1000000000000"
testing_cpp_cli -int_unbound 1T 2>&1 | grep "int_unbound: 1000000000000"
# A fractional prefix is multiplied then rounded to the nearest integer.
testing_cpp_cli -int_unbound 1.5k 2>&1 | grep "int_unbound: 1500"
testing_cpp_cli -int_unbound 3.5b 2>&1 | grep "int_unbound: 3500000000"
# A single mid-string "e"/"E" selects scientific-notation parsing, rounded to integer.
testing_cpp_cli -int_unbound 1e3 2>&1 | grep "int_unbound: 1000"
testing_cpp_cli -int_unbound 1e10 2>&1 | grep "int_unbound: 10000000000"
# The range check is applied AFTER multiplication (-int_bound permits 0 to 100):
#   "0k" multiplies to an in-range 0, but "1k" multiplies to an out-of-range 1000.
testing_cpp_cli -int_bound 0k 2>&1 | grep "int_bound: 0"
! testing_cpp_cli -int_bound 1k
# Erroneous suffixes are rejected: an unknown postfix, a trailing non-suffix, or two letters.
! testing_cpp_cli -int_unbound 5x
! testing_cpp_cli -int_unbound 1k1
! testing_cpp_cli -int_unbound 1e3k
# Integer sequences deliberately do NOT apply multipliers (matches parse_ints()).
! testing_cpp_cli -int_seq 5k

# Dedicated lmax argument types: a scalar lmax must be a non-negative even integer; a vector lmax
#   requires each element to be non-negative and even. Any command-authored numeric bound is a
#   separate check applied AFTER the even/sign check (an even but out-of-range value reports the
#   generic out-of-bounds error, not the lmax error).
testing_cpp_cli -lmax 0 2>&1 | grep "lmax: 0"
testing_cpp_cli -lmax 8 2>&1 | grep "lmax: 8"
# An odd or negative scalar lmax reports the dedicated lmax error.
! testing_cpp_cli -lmax 3
! testing_cpp_cli -lmax -2
# An even value that merely exceeds a command-specified bound reports the generic range error.
testing_cpp_cli -lmax_bound 8 2>&1 | grep "lmax_bound: 8"
! testing_cpp_cli -lmax_bound 10
! testing_cpp_cli -lmax_bound 7
# Vector lmax: every element must be non-negative and even.
testing_cpp_cli -lmax_seq 0,2,4 2>&1 | grep "lmax_seq: \[0,2,4\]"
! testing_cpp_cli -lmax_seq 0,3
! testing_cpp_cli -lmax_seq 2,-4

# Argument tuples: a multi-field option consumes exactly its field count and its fields are
#   addressable by name. "-nargs_two" (no field descriptions) and "-tuple_desc" (described fields)
#   both parse two tokens; too few tokens is an error.
testing_cpp_cli -nargs_two first second 2>&1 | grep "nargs_two: \[first second\]"
testing_cpp_cli -tuple_desc mykey myvalue 2>&1 | grep "tuple_desc: \[mykey myvalue\]"
! testing_cpp_cli -tuple_desc onlyone

# Parse-time group constraints: the nested "-mode_a"/"-mode_b" sub-group is mutually exclusive,
#   so at most one may be specified. Neither, or exactly one, is valid; both is an error reported
#   before any input file is accessed.
testing_cpp_cli 2>&1
testing_cpp_cli -mode_a 2>&1 | grep "mode_a option present"
testing_cpp_cli -mode_b 2>&1 | grep "mode_b option present"
! testing_cpp_cli -mode_a -mode_b
# The inherited verbosity sub-group of Standard options is likewise mutually exclusive.
testing_cpp_cli -info 2>&1
! testing_cpp_cli -info -debug

# Unused-option tracking: an option that is specified but never read by the command emits a
#   single end-of-run advisory (the command still succeeds).
testing_cpp_cli -unused 2>&1 | grep "was specified but had no effect"
# An option that IS read by the command does not trigger the advisory.
! ( testing_cpp_cli -flag 2>&1 | grep "had no effect" )

# Verify correct parsing of option arguments that begin with a dash.
testing_cpp_cli -int_unbound -123 2>&1 | grep "int_unbound: -123"
! testing_cpp_cli -int_unbound --1
testing_cpp_cli -float_unbound -1.5 2>&1 | grep "float_unbound: -1.5"
! testing_cpp_cli -float_unbound --1.5
testing_cpp_cli -text "-a-b-c" 2>&1 | grep "text: -a-b-c"
#testing_cpp_cli -file_out - 2>&1 | grep "file_out: -"
testing_cpp_cli -int_seq -1,-1,-1,5 2>&1 | grep "int_seq: \[-1,-1,-1,5\]" # Ensure the brackets are escaped for grep
! testing_cpp_cli -int_seq --1,1
testing_cpp_cli -float_seq -1.5,1.5 2>&1 | grep "float_seq: \[-1.5,1.5\]"
! testing_cpp_cli -float_seq --1.5,1.5

# Options requiring arguments should fail if no argument is provided
! testing_cpp_cli -choice
! testing_cpp_cli -text
! testing_cpp_cli -bool
! testing_cpp_cli -int_unbound
! testing_cpp_cli -int_nonneg
! testing_cpp_cli -int_bound
! testing_cpp_cli -float_unbound
! testing_cpp_cli -float_nonneg
! testing_cpp_cli -float_bound
! testing_cpp_cli -int_seq
! testing_cpp_cli -float_seq
! testing_cpp_cli -file_in
! testing_cpp_cli -file_out
! testing_cpp_cli -dir_in
! testing_cpp_cli -dir_out
! testing_cpp_cli -tracks_in
! testing_cpp_cli -tracks_out
! testing_cpp_cli -any
! testing_cpp_cli -nargs_two
! testing_cpp_cli -nargs_two first

# Unsupported options should fail
! testing_cpp_cli -unsupported_option
! testing_cpp_cli -2244223

# Test handling of various dash-like characters
# Skip the dash tests on MSYS2 as they don't seem to be correctly parsed by CTest
# TODO: try to find whether there is a solution to this
if ![[ -z "${MSYSTEM}" ]]; then
    testing_cpp_cli —bool false # Em dash
    testing_cpp_cli –bool false # En dash
    testing_cpp_cli -bool false # Hyphen
fi

# Test interfaces relating to filesystem paths:
# - Make sure that command fails if expected input is not present
# - Make sure that existing outputs either succeed or fail depending on the presence of the -force option
rm -rf tmp-dirin/ && ! testing_cpp_cli -dir_in tmp-dirin/
trap "rm -rf tmp-dirout/" EXIT; mkdir -p tmp-dirout/ && ! testing_cpp_cli -dir_out tmp-dirout/
trap "rm -rf tmp-dirout/" EXIT; mkdir -p tmp-dirout/ && testing_cpp_cli -dir_out tmp-dirout/ -force
rm -f tmp-filein.txt && ! testing_cpp_cli -file_in tmp-filein.txt
trap "rm -f tmp-fileout.txt" EXIT; touch tmp-fileout.txt && ! testing_cpp_cli -file_out tmp-fileout.txt
trap "rm -f tmp-fileout.txt" EXIT; touch tmp-fileout.txt && testing_cpp_cli -file_out tmp-fileout.txt -force
rm -f tmp-tracksin.tck && ! testing_cpp_cli -tracks_in tmp-tracksin.tck
trap "rm -f tmp-filein.txt" EXIT; touch tmp-filein.txt && ! testing_cpp_cli -tracks_in tmp-filein.txt
trap "rm -f tmp-tracksout.txt" EXIT; touch tmp-tracksout.tck && ! testing_cpp_cli -tracks_out tmp-tracksout.tck
trap "rm -f tmp-tracksout.txt" EXIT; touch tmp-tracksout.tck && testing_cpp_cli -tracks_out tmp-tracksout.tck -force
