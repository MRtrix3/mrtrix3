#!/bin/bash
# Various tests of the functionality of the Pyhon command-line interface

# Utilisation of all argument types
trap "rm -rf tmp-dirin/ tmp-filein.txt tmp-tracksin.tck" EXIT; \
mkdir -p tmp-dirin/ \
    && touch tmp-filein.txt \
    && touch tmp-tracksin.tck \
    && testing_python_cli \
        -flag \
        -string_implicit my_implicit_string \
        -string_explicit my_explicit_string \
        -choice One \
        -bool false \
        -int_builtin 0 \
        -float_builtin 0.0 \
        -int_unbound 0 \
        -int_nonneg 1 \
        -int_bound 50 \
        -float_unbound 0.0 \
        -float_nonneg 1.0 \
        -float_bound 0.5 \
        -int_seq 1,2,3 \
        -float_seq 0.1,0.2,0.3 \
        -dir_in tmp-dirin/ \
        -dir_out tmp-dirout/ \
        -file_in tmp-filein.txt \
        -file_out tmp-fileout.txt \
        -tracks_in tmp-tracksin.tck \
        -tracks_out tmp-tracksout.tck \
        -custom my_custom

# Multi-spelling option / choice-value aliases (mirrors the C++ behaviour, spelling-design.md).
# The canonical "-choice" option also answers to the alias "-choose", and the choice value
#   "One" also accepts the alias spelling "uno"; both resolve to the canonical value stored
#   under the canonical destination.
# Canonical spelling of both the option and the choice value.
testing_python_cli -choice One 2>&1 | grep "choice: 'One'"
# Full alias spelling of the option resolves to the canonical option.
testing_python_cli -choose One 2>&1 | grep "choice: 'One'"
# A prefix shared by the canonical name and the alias collapses to the one option (no spurious
#   "several matches"): "-cho" prefixes both "choice" and "choose", which are the same option.
testing_python_cli -cho One 2>&1 | grep "choice: 'One'"
# A prefix specific to the canonical name, and one specific to the alias, each resolve.
testing_python_cli -choic One 2>&1 | grep "choice: 'One'"
testing_python_cli -choos One 2>&1 | grep "choice: 'One'"
# The choice-value alias "uno" is canonicalised to "One" at parse time, via either spelling
#   of the option.
testing_python_cli -choice uno 2>&1 | grep "choice: 'One'"
testing_python_cli -choose uno 2>&1 | grep "choice: 'One'"
# An unknown choice value is still rejected (the alias adds a spelling, it does not relax validation).
! testing_python_cli -choice NotAChoice

# Ensure that export of the command-line interfaces in various file formats obeys expectations
trap "rm -f tmp.txt" EXIT; \
    testing_python_cli -help | \
    tail -n +3 | \
    diff -a --strip-trailing-cr - python_cli/help.txt
trap "rm -f tmp.txt" EXIT; \
    testing_python_cli __print_full_usage__ | \
    diff -a --strip-trailing-cr - python_cli/full_usage.txt
trap "rm -f tmp.md" EXIT; \
    testing_python_cli __print_usage_markdown__ | \
    diff -a --strip-trailing-cr - python_cli/markdown.md
trap "rm -f tmp.rst" EXIT; \
    testing_python_cli __print_usage_rst__ | \
    diff -a --strip-trailing-cr - python_cli/restructured_text.rst

# Test various argument types for both appropriate and inappropriate inputs
testing_python_cli -bool false
testing_python_cli -bool False
testing_python_cli -bool FALSE
testing_python_cli -bool true
testing_python_cli -bool True
testing_python_cli -bool TRUE
testing_python_cli -bool 0
testing_python_cli -bool 1
testing_python_cli -bool 2
! testing_python_cli -bool NotABool
! testing_python_cli -int_builtin 0.1
! testing_python_cli -int_builtin NotAnInt
! testing_python_cli -int_unbound 0.1
! testing_python_cli -int_unbound NotAnInt
! testing_python_cli -int_nonneg -1
! testing_python_cli -int_bound 101
! testing_python_cli -float_builtin NotAFloat
! testing_python_cli -float_unbound NotAFloat
! testing_python_cli -float_nonneg -0.1
! testing_python_cli -float_bound 1.1
! testing_python_cli -int_seq 0.1,0.2,0.3
! testing_python_cli -int_seq Not,An,Int,Seq
! testing_python_cli -float_seq Not,A,Float,Seq

# Integer suffix multipliers on scalar integer types (mirrors the C++
#   ParsedArgument::as_int(); decimal multipliers k/K=1e3, m/M=1e6, b/B=1e9, t/T=1e12).
# Each multiplier, upper and lower case.
testing_python_cli -int_unbound 5k 2>&1 | grep "int_unbound: 5000"
testing_python_cli -int_unbound 5K 2>&1 | grep "int_unbound: 5000"
testing_python_cli -int_unbound 3m 2>&1 | grep "int_unbound: 3000000"
testing_python_cli -int_unbound 3M 2>&1 | grep "int_unbound: 3000000"
# "b"/"B" is a decimal billion (1e9), NOT a bytes multiplier.
testing_python_cli -int_unbound 2b 2>&1 | grep "int_unbound: 2000000000"
testing_python_cli -int_unbound 2B 2>&1 | grep "int_unbound: 2000000000"
testing_python_cli -int_unbound 1t 2>&1 | grep "int_unbound: 1000000000000"
testing_python_cli -int_unbound 1T 2>&1 | grep "int_unbound: 1000000000000"
# A fractional prefix is evaluated by exact integer scaling when the result is an exact integer.
testing_python_cli -int_unbound 1.5k 2>&1 | grep "int_unbound: 1500"
testing_python_cli -int_unbound 2.5k 2>&1 | grep "int_unbound: 2500"
testing_python_cli -int_unbound 3.5b 2>&1 | grep "int_unbound: 3500000000"
# A single mid-string "e"/"E" selects scientific-notation parsing (also exact-integer only).
testing_python_cli -int_unbound 1e3 2>&1 | grep "int_unbound: 1000"
testing_python_cli -int_unbound 1e10 2>&1 | grep "int_unbound: 10000000000"
# A large-but-exact scientific value is accepted (no precision loss).
testing_python_cli -int_unbound 1.2345e10 2>&1 | grep "int_unbound: 12345000000"
# A fractional prefix or scientific mantissa that would not scale to an exact integer is rejected
#   rather than silently rounded.
! testing_python_cli -int_unbound 1.2345k
! testing_python_cli -int_unbound 2.5e-2
# The range check is applied AFTER multiplication (-int_bounded permits 0 to 100):
#   "0k" multiplies to an in-range 0, but "1k" multiplies to an out-of-range 1000.
testing_python_cli -int_bounded 0k 2>&1 | grep "int_bounded: 0"
! testing_python_cli -int_bounded 1k
# Erroneous suffixes are rejected: an unknown postfix, a trailing non-suffix, or two letters.
! testing_python_cli -int_unbound 5x
! testing_python_cli -int_unbound 1k1
! testing_python_cli -int_unbound 1e3k
# Integer sequences deliberately do NOT apply multipliers (matches C++ parse_ints()).
! testing_python_cli -int_seq 5k
testing_python_cli -int_seq 1,2,3 2>&1 | grep "int_seq: \[1, 2, 3\]"

# Dedicated lmax argument types (mirrors the C++ type_lmax / type_sequence_lmax): a scalar lmax
#   must be a non-negative even integer; a vector lmax requires each element to be non-negative
#   and even. A command-authored numeric bound is a separate check applied after the even/sign check.
testing_python_cli -lmax 0 2>&1 | grep "lmax: 0"
testing_python_cli -lmax 8 2>&1 | grep "lmax: 8"
# An odd or negative scalar lmax reports the dedicated lmax error.
! testing_python_cli -lmax 3
! testing_python_cli -lmax -2
# An even value that merely exceeds a command-specified bound is rejected by the range check.
testing_python_cli -lmax_bounded 8 2>&1 | grep "lmax_bounded: 8"
! testing_python_cli -lmax_bounded 10
! testing_python_cli -lmax_bounded 7
# Vector lmax: every element must be non-negative and even.
testing_python_cli -lmax_seq 0,2,4 2>&1 | grep "lmax_seq: \[0, 2, 4\]"
! testing_python_cli -lmax_seq 0,3
! testing_python_cli -lmax_seq 2,-4

# Unused-option tracking: an option specified but never read emits a single end-of-run advisory
#   (the command still succeeds). "-unused" is deliberately left unread by the command body.
testing_python_cli -unused 2>&1 | grep "was specified but had no effect"
# An option that IS read by the command does not trigger the advisory.
! ( testing_python_cli -flag 2>&1 | grep "had no effect" )

# Deprecated options: specifying one warns but does not fail, and the option remains functional.
testing_python_cli -deprecated 2>&1 | grep 'use of deprecated option "-deprecated"'
testing_python_cli -deprecated 2>&1 | grep "deprecated: True"
# An option not flagged as deprecated yields no such warning.
! ( testing_python_cli -flag 2>&1 | grep "use of deprecated option" )

# Verify correct parsing of option arguments that begin with a dash.
testing_python_cli -int_unbound -123 2>&1 | grep "int_unbound: -123"
! testing_python_cli -int_unbound --1
testing_python_cli -float_unbound -1.5 2>&1 | grep "float_unbound: -1.5"
! testing_python_cli -float_unbound --1.5
#testing_python_cli -file_out - 2>&1 | grep "file_out: -"
! testing_python_cli -int_seq --1,1
! testing_python_cli -float_seq --1.5,1.5
# Following tests currently *not* working due to argparse
#testing_python_cli -float_seq -1.5,1.5 2>&1 | grep "float_seq: \[-1.5,1.5\]"
#testing_python_cli -string_explicit "-a-b-c" 2>&1 | grep "string: -a-b-c"
#testing_python_cli -string_implicit "-a-b-c" 2>&1 | grep "string: -a-b-c"
#testing_python_cli -int_seq -1,-1,-1,5 2>&1 | grep "int_seq: \[-1,-1,-1,5\]"

# Tests relating to filesystem paths:
# - Ensure that absent inputs result in appropriate error
# - Ensure that pre-existing output paths are handled accordingly
#   based on presence or absence of -force option
rm -rf tmp-dirin/ && ! testing_python_cli -dir_in tmp-dirin/
trap "rm -rf tmp-dirout/" EXIT; mkdir -p tmp-dirout/ && ! testing_python_cli -dir_out tmp-dirout/
trap "rm -rf tmp-dirout/" EXIT; mkdir -p tmp-dirout/ && testing_python_cli -dir_out tmp-dirout/ -force
rm -f tmp-filein.txt && ! testing_python_cli -file_in tmp-filein.txt
trap "rm -f tmp-fileout.txt" EXIT; touch tmp-fileout.txt && ! testing_python_cli -file_out tmp-fileout.txt
trap "rm -f tmp-fileout.txt" EXIT; touch tmp-fileout.txt && testing_python_cli -file_out tmp-fileout.txt -force
rm -f tmp-tracksin.tck && ! testing_python_cli -tracks_in tmp-tracksin.tck
trap "rm -f tmp-filein.txt" EXIT; touch tmp-filein.txt && ! testing_python_cli -tracks_in tmp-filein.txt
trap "rm -f tmp-tracksout.txt" EXIT; touch tmp-tracksout.tck && ! testing_python_cli -tracks_out tmp-tracksout.tck
trap "rm -f tmp-tracksout.txt" EXIT; touch tmp-tracksout.tck && testing_python_cli -tracks_out tmp-tracksout.tck -force

