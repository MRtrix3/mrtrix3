#!/bin/bash
# Verify default smooth filter operation on a mesh
# Apply smoothing to a well-formed input mesh and compare to a reference output
# Ensure that output matches that generated by a prior software version
# REFERENCE: Run this on a stable version:
#   meshfilter meshconvert/in_ascii.vtk smooth meshfilter/smooth.vtk -force;
#   cp meshfilter/smooth.vtk meshfilter/

meshfilter meshconvert/in_ascii.vtk smooth - | \
testing_diff_mesh - meshfilter/smooth.vtk 0.001
