#!/bin/bash
# Verify warp inversion with a template image to define the output grid
# Invert warp.mif using dwi.mif as a template,
#   and verify that the output has the same grid as dwi.mif
# REFERENCE: This test does not require pre-generated reference data

warpinvert warp.mif tmp_inv.mif -template dwi.mif -force

# Verify the output dimensions match the template image
DIM_TEMPLATE=$(mrinfo dwi.mif -size | awk '{print $1, $2, $3}')
DIM_OUT=$(mrinfo tmp_inv.mif -size | awk '{print $1, $2, $3}')
[ "$DIM_TEMPLATE" = "$DIM_OUT" ]
