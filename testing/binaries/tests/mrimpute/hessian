#!/bin/bash
# The Hessian-energy method imposes natural (free) boundary conditions and, like
#   the biharmonic method, annihilates affine fields - so it extrapolates a
#   linear ramp into a non-finite border accurately, unlike the harmonic
#   "laplacian" method (which flattens toward a constant) or "spring" (which
#   extrapolates a constant by construction). Build f = x + y + z over a padded
#   grid, blank its border to NaN, and confirm the Hessian extrapolation error is
#   both small in absolute terms and smaller than the harmonic and constant
#   methods.

# 7x7x7 grid template: a 5x5x5 interior padded by one voxel on every side.
mrconvert mask.mif -coord 0 0:4 -coord 1 0:4 -coord 2 0:4 tmp_grid5.mif -force -quiet
mrgrid tmp_grid5.mif pad -uniform 1 tmp_grid7.mif -force -quiet

# Build f = x + y + z over the full padded grid: the truth, finite on the border.
make_ramp () {
  axis=$1; out=$2
  sz=$(mrinfo tmp_grid7.mif -size | cut -d' ' -f$((axis+1)))
  files=""
  for i in $(seq 0 $((sz-1))); do
    mrconvert tmp_grid7.mif -coord $axis $i - -quiet | \
      mrcalc - 0 -mult $i -add tmp_slab_${axis}_${i}.mif -force -quiet
    files="$files tmp_slab_${axis}_${i}.mif"
  done
  mrcat $files -axis $axis $out -force -quiet
}
make_ramp 0 tmp_rx.mif
make_ramp 1 tmp_ry.mif
make_ramp 2 tmp_rz.mif
mrcalc tmp_rx.mif tmp_ry.mif -add tmp_rz.mif -add tmp_truth.mif -force -quiet

# Input: the truth interior, with its entire one-voxel border replaced by NaN.
mrgrid tmp_truth.mif crop -uniform 1 tmp_inner.mif -force -quiet
mrgrid tmp_inner.mif pad -uniform 1 -fill nan tmp_input.mif -force -quiet

# The maximum absolute extrapolation error of each method, with no detrending.
border_error () {
  method=$1
  mrimpute tmp_input.mif -method $method tmp_out_${method}.mif -force -quiet
  mrcalc tmp_out_${method}.mif tmp_truth.mif -subtract -abs - -quiet | \
    mrstats - -output max | tr -d ' '
}
err_hessian=$(border_error hessian)
err_laplacian=$(border_error laplacian)
err_spring=$(border_error spring)

# The Hessian method must extrapolate the linear ramp essentially exactly.
awk -v h="$err_hessian" 'BEGIN { exit !(h < 0.01) }'

# ... and strictly more accurately than either the harmonic or constant method.
awk -v h="$err_hessian" -v l="$err_laplacian" -v s="$err_spring" \
  'BEGIN { exit !(h < l && h < s) }'
