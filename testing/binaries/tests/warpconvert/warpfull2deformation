#!/bin/bash
# Verify conversion from a warpfull (5D) image to a deformation field
# The mrregister/warp_full.mif.gz is a full warp series as output by mrregister -nl_warp_full;
#   converting it to a deformation field using moving.mif.gz as template
#   should produce a 4D deformation field
# Ensure that output matches that generated by a prior software version
#
# Note that for the example full warp image already specified in the test data,
#   the target image is unknown,
#   and therefore it is not possible to define the target voxel grid
#   for warps from image1 to image2

warpconvert mrregister/warp_full.mif.gz warpfull2deformation \
    -template dwi2fod/msmt_csd/wm.mif \
    -from 2 \
    - | \
testing_diff_image - warpconvert/warpfull2deformation_from2.mif.gz -abs 1e-5

warpconvert mrregister/warp_full.mif.gz warpfull2deformation - \
    -midway_space -from 1 | \
testing_diff_image - warpconvert/warpfull2deformation_midway_from1.mif.gz -abs 1e-5
warpconvert mrregister/warp_full.mif.gz warpfull2deformation - \
    -midway_space -from 2 | \
testing_diff_image - warpconvert/warpfull2deformation_midway_from2.mif.gz -abs 1e-5
