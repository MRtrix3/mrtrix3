#!/bin/bash
# Verify conversion from a warpfull (5D) image to a displacement field
# The mrregister/warp_full.mif.gz is a full warp series as output by mrregister -nl_warp_full;
#   converting it to a displacement field in the midway space
#   should produce a 4D displacement field
# Ensure that output matches that generated by a prior software version
# REFERENCE: Run this on a stable version:
#   warpconvert mrregister/warp_full.mif.gz warpfull2displacement \
#     warpconvert/warpfull2displacement_midway_from2.mif.gz \
#     -midway_space -from 2 -force;
#   cp warpconvert/warpfull2displacement_midway_from2.mif.gz warpconvert/

warpconvert mrregister/warp_full.mif.gz warpfull2displacement - \
    -midway_space -from 2 | \
testing_diff_image - warpconvert/warpfull2displacement_midway_from2.mif.gz -abs 1e-4
