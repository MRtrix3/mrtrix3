#!/bin/bash
# Verify conversion from a warpfull (5D) image to a displacement field
# The mrregister/warp_full.mif.gz is a full warp series as output by mrregister -nl_warp_full
# Ensure that output matches that generated by a prior software version

warpconvert mrregister/warp_full.mif.gz warpfull2displacement \
    -template dwi2fod/msmt_csd/wm.mif \
    -from 2 \
    - | \
testing_diff_image - warpconvert/warpfull2displacement_from2.mif.gz -abs 1e-5

warpconvert mrregister/warp_full.mif.gz warpfull2displacement - \
    -midway_space -from 1 | \
testing_diff_image - warpconvert/warpfull2displacement_midway_from1.mif.gz -abs 1e-5
warpconvert mrregister/warp_full.mif.gz warpfull2displacement - \
    -midway_space -from 2 | \
testing_diff_image - warpconvert/warpfull2displacement_midway_from2.mif.gz -abs 1e-5
