#!/bin/bash
# Verify operation of the -blocky option
# Convert a binary mask image to a mesh using the blocky (voxel-face tracing) algorithm;
#   compare the output mesh to a reference generated by a prior software version
# Ensure that output matches that generated by a prior software version
# REFERENCE: Run this on a stable version:
#   voxel2mesh mask.mif -blocky voxel2mesh/blocky.obj -force;
#   cp voxel2mesh/blocky.obj voxel2mesh/

voxel2mesh mask.mif -blocky - | \
testing_diff_mesh - voxel2mesh/blocky.obj 0.001
