#!/bin/bash
# Check operation of an arbitrary mathematical expressions that contains
# standard MRtrix3 options between operands. This is to ensure that arguments
# are correctly parsed and processed.
# Note: -info and -debug belong to the mutually-exclusive verbosity sub-group, so only one
#   verbosity flag may appear on a single invocation; -info exercises option interleaving here.
# Ensure that output matches that generated by a prior software version
mrcalc mrcalc/in.mif 2 -mult -info -neg -exp 10 -nthreads 2 -add - | \
testing_diff_image - mrcalc/out1.mif -frac 1e-5
