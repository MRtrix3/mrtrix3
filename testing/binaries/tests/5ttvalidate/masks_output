#!/bin/bash
# Test the -voxels option of 5ttvalidate
# The -voxels option writes a binary mask image highlighting voxels
#   where the input does not conform to 5TT format requirements.
# This test constructs an image with a known non-physical partial volume fraction in one voxel,
#   runs 5ttvalidate with -voxels, and verifies that:
#   1. The command exits with an error (as expected for a non-physical image)
#   2. The output voxel mask file is created
#   3. The known error voxel is flagged in the mask

# Extract and zero the CSF volume
mrconvert 5ttedit/in.mif -coord 3 0 -axes 0,1,2 - | \
  mrcalc - 0 -mult tmp_zero.mif -force

# Generate a mask for a single known voxel
mredit tmp_zero.mif tmp_one.mif -force \
  -voxel 34,51,46 1

# Make the CSF fraction less than 0 in that voxel by shifting -0.1,
#   adding 0.1 back to sub-cortical GM to preserve the unity sum
mrcat tmp_zero.mif \
  $(mrcalc tmp_one.mif 0.1 -mult -) \
  tmp_zero.mif \
  $(mrcalc tmp_one.mif -0.1 -mult -) \
  tmp_zero.mif \
  -axis 3 - | \
mrcalc 5ttedit/in.mif - -add tmp_invalid.mif -force

# Run 5ttvalidate with -voxels; the command must fail due to non-physical PVFs,
#   and the mask output file must be created
! ( 5ttvalidate tmp_invalid.mif -voxels tmp_mask.mif 2>&1 )

# The mask file must have been created
[ -f tmp_mask.mif ]

# The known error voxel (34,51,46) must be non-zero in the output mask
VAL=$(mrconvert tmp_mask.mif -coord 0 34 -coord 1 51 -coord 2 46 - | mrstats - -output mean)
awk -v v="$VAL" 'BEGIN { if (v + 0 == 0) { print "ERROR: expected error voxel not flagged in mask"; exit 1 } }'
