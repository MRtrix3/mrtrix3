#!/bin/bash
# Per-vertex embedding via the qualified "DATASET::NAME" form into a NON-EXISTENT
#   dataset: fixel2tsf creates the dataset as a copy of the input tractogram carrying
#   the sampled per-vertex fixel field, generated in the mapping pass. The streamline
#   geometry must round-trip back to the input (read via tckconvert); the embedded
#   VALUES are checked once the qualified sidecar import path lands.
rm -rf tmp_dpv.trx tmp_dpv_rt.tck
fixel2tsf fixel_image/afd.mif tracks.tck tmp_dpv.trx::afd -force
tckconvert tmp_dpv.trx tmp_dpv_rt.tck -force
testing_diff_tck tmp_dpv_rt.tck tracks.tck
