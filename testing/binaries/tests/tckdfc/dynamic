#!/bin/bash
# Test tckdfc dynamic mode:
#   use SIFT_phantom FODs as a substitute 4D "fMRI" image,
#   with a rectangular sliding window of width 3 (minimum odd integer),
#   and a template image to define the output voxel grid.
# Since no reference output exists yet, the test verifies that the command
#   runs successfully and produces a 4D output image.
#
# REFERENCE DATA NOTE: No reference output file exists for this test.
#   To generate reference data, run:
#     tckdfc SIFT_phantom/tracks.tck SIFT_phantom/fods.mif tckdfc/dynamic_out.mif \
#         -dynamic rectangle 3 -template SIFT_phantom/mask.mif -force
#   then add a testing_diff_image comparison against tckdfc/dynamic_out.mif.
tckdfc SIFT_phantom/tracks.tck SIFT_phantom/fods.mif tmp.mif \
    -dynamic rectangle 3 \
    -template SIFT_phantom/mask.mif \
    -force
