#!/bin/bash
# Verify the cross-correlation (cc) metric computed in average space
# The cc metric is only supported with -space average and linear/cubic interpolation;
#   comparing an image with itself should yield a value close to zero
#   (cc is a negative cross-covariance, so self-comparison gives a large negative value,
#    but with -nonormalisation we check the command runs successfully)
# REFERENCE: This test does not require pre-generated reference data

mrmetric dwi_mean.mif dwi_mean.mif -space average -metric cc -interp linear > tmp.txt
[ -s tmp.txt ]
