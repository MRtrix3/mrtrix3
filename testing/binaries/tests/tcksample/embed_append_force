#!/bin/bash
# In-place augmentation requires -force only when the named field is ALREADY present:
#   the first append of a new field succeeds without -force; a second append of the
#   same field name fails without -force and succeeds with it.
rm -rf tmp_apf.trx tmp_apf.txt
tckconvert tracks.tck tmp_apf.trx -config TRXArchiveCompression store -force
tcksample tracks.tck tcksample/fa.mif tmp_apf.trx::FA -stat_tck mean
! tcksample tracks.tck tcksample/fa.mif tmp_apf.trx::FA -stat_tck mean 2> tmp_apf.txt
cat tmp_apf.txt
grep -i "already exists" tmp_apf.txt
tcksample tracks.tck tcksample/fa.mif tmp_apf.trx::FA -stat_tck mean -force
