#!/bin/bash
# Round-trip via a VTK intermediary in both encodings: vtk -> tck -> vtk must
#   preserve the streamline data (compared in the .tck domain, which is encoding-
#   agnostic). Exercises both the framework VTK reader and writer.

# Binary intermediary
tckconvert tracks.tck tmp_b.vtk -force -quiet
tckconvert tmp_b.vtk tmp_b1.tck -force -quiet
tckconvert tmp_b1.tck tmp_b2.vtk -force -quiet
tckconvert tmp_b2.vtk tmp_b2.tck -force -quiet
testing_diff_tck tmp_b1.tck tmp_b2.tck

# ASCII intermediary
tckconvert -ascii tracks.tck tmp_a.vtk -force -quiet
tckconvert tmp_a.vtk tmp_a1.tck -force -quiet
tckconvert -ascii tmp_a1.tck tmp_a2.vtk -force -quiet
tckconvert tmp_a2.vtk tmp_a2.tck -force -quiet
testing_diff_tck tmp_a1.tck tmp_a2.tck
