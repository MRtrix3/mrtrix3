#!/bin/bash
# The framework VTK reader must reject a .vtk file containing dataset fields other
#   than POINTS and LINES (a tractogram is representable only as POINTS + LINES).
# Construct a minimal POLYDATA file with a POLYGONS field and confirm the conversion
#   fails cleanly (non-zero exit).
printf '# vtk DataFile Version 3.0\ntest\nASCII\nDATASET POLYDATA\nPOINTS 3 float\n0 0 0\n1 0 0\n2 0 0\nPOLYGONS 1 4\n3 0 1 2\n' > tmp_bad_poly.vtk
tckconvert tmp_bad_poly.vtk tmp_bad_poly.tck -force -quiet 2>/dev/null && { echo "Expected rejection of non-POINTS/LINES VTK"; exit 1; }
true
