#!/bin/bash
# Reference-data interop (VTX_DATA_DIR, rordenlab TractographyFormat): write
#   "example.tck" out as TrackVis ".trk" and compare to "example.trk".
#
# The ".tck" input carries no reference voxel grid, so the ".trk" writer announces
#   (INFO) that the voxel->realspace transform is left unrecorded (vox_to_ras[3][3]
#   = 0); that is asserted first.
tckconvert example.tck tmp_tck2trk.trk -info -force 2>tmp_info.txt
grep -q "the voxel-to-realspace transform will not be recorded (vox_to_ras\[3\]\[3\] = 0)" tmp_info.txt
python3 -c "import struct,sys; b=open('tmp_tck2trk.trk','rb').read(); sys.exit(0 if struct.unpack('<f', b[500:504])[0]==0.0 else 1)"

# Compare to "example.trk" by bridging both files through the ".tck" domain: a
#   grid-less ".trk" reads back as realspace, while "example.trk"'s recorded affine
#   is undone with the half-voxel shift, so both recover "example.tck".
if cmp -s tmp_tck2trk.trk example.trk; then
  exit 0
fi
tckconvert tmp_tck2trk.trk tmp_mine_dec.tck -force -quiet
tckconvert example.trk tmp_ref_dec.tck -force -quiet
testing_diff_tck tmp_mine_dec.tck tmp_ref_dec.tck -distance 1e-4
