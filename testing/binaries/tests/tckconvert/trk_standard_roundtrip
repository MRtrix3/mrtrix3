#!/bin/bash
# Reference-data interop (TRK_DATA_DIR, nibabel): "standard.trk" / "standard.tck"
#   are nibabel's matched exemplars on an anisotropic grid (voxel size 1x3x2,
#   vox_to_ras = diag(1,3,2)). Both conversion directions are exercised; the
#   half-voxel corner shift is scaled per-axis by the anisotropic voxel size.

# Direction 1: standard.trk -> tck (recorded affine undone with the half-voxel shift).
tckconvert standard.trk tmp_trk2tck.tck -force -quiet
if ! cmp -s tmp_trk2tck.tck standard.tck; then
  testing_diff_tck tmp_trk2tck.tck standard.tck -distance 1e-4
fi

# Direction 2: standard.tck -> trk, compared to standard.trk (bridged through ".tck";
#   the grid-less write records no affine, so the bytes differ but the geometry agrees).
tckconvert standard.tck tmp_tck2trk.trk -force -quiet
if ! cmp -s tmp_tck2trk.trk standard.trk; then
  tckconvert tmp_tck2trk.trk tmp_mine_dec.tck -force -quiet
  tckconvert standard.trk tmp_ref_dec.tck -force -quiet
  testing_diff_tck tmp_mine_dec.tck tmp_ref_dec.tck -distance 1e-4
fi
