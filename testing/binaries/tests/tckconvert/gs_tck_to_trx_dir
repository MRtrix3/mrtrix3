#!/bin/bash
# Reference-data validation (TRX_DATA_DIR, tee-ar-ex gold standard): write "gs.tck"
#   directly to a TRX *directory* dataset, embedding into the output header the
#   spatial grid of the reference image "gs.nii" (the image from which the gold
#   standard "gs_fldr.trx/" was generated) via tckconvert's -reference_image option.
#   All four compulsory TRX header fields (DIMENSIONS, VOXEL_TO_RASMM,
#   NB_STREAMLINES, NB_VERTICES) must reproduce the gold "gs_fldr.trx/header.json".
#
# The trailing path separator on the output path makes the directory intent
#   explicit, so the TRX directory handler writes the member files straight into
#   the directory (no intermediate ".trx" archive, no /tmp staging).
set -e

rm -rf tmp_dir.trx
tckconvert gs.tck tmp_dir.trx/ -reference_image gs.nii -quiet

# The dataset is an unpacked directory carrying the spec-mandated array members.
test -f tmp_dir.trx/header.json
test -f tmp_dir.trx/offsets.uint32
test -f tmp_dir.trx/positions.3.float32

# All four compulsory TRX header fields must match the gold standard: the integer
#   counts and grid dimensions exactly, and the voxel-to-RASMM affine to float32
#   precision (the gold affine is stored float32, recovered here from "gs.nii").
python3 - <<'PY'
import json
mine = json.load(open('tmp_dir.trx/header.json'))
gold = json.load(open('gs_fldr.trx/header.json'))
for k in ('NB_STREAMLINES', 'NB_VERTICES', 'DIMENSIONS'):
    assert mine[k] == gold[k], f"{k}: {mine[k]} vs {gold[k]}"
m, g = mine['VOXEL_TO_RASMM'], gold['VOXEL_TO_RASMM']
assert len(m) == 4 and all(len(row) == 4 for row in m), m
for i in range(4):
    for j in range(4):
        assert abs(m[i][j] - g[i][j]) < 1e-4, (i, j, m[i][j], g[i][j])
print("all four compulsory TRX header fields match gold")
PY
