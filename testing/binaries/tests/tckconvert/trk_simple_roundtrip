#!/bin/bash
# Reference-data interop (TRK_DATA_DIR, nibabel): "simple.trk" / "simple.tck" are
#   nibabel's matched minimal TrackVis / MRtrix exemplars. This bundles both
#   conversion directions plus the grid-less ".trk" INFO assertion.
#
# The INFO assertion (no reference grid => vox_to_ras[3][3] = 0) is checked first
#   on the ".tck" -> ".trk" write and PASSES.
tckconvert simple.tck tmp_simple_out.trk -info -force 2>tmp_simple_info.txt
grep -q "the voxel-to-realspace transform will not be recorded (vox_to_ras\[3\]\[3\] = 0)" tmp_simple_info.txt

# RUN-AND-FAIL (TODO): both geometric comparisons then fail. nibabel writes ".trk"
#   voxel-mm with a corner-origin and recovers RASMM with a half-voxel centre
#   shift; MRtrix's ".trk" path omits that shift, so "simple.trk" <-> "simple.tck"
#   disagree by ~0.5 voxel (~0.5 mm here), beyond the 1e-4 mm budget. Reconciling
#   the ".trk" corner-origin convention with nibabel resolves both.

# Direction 1: simple.trk -> tck, compare to simple.tck.
tckconvert simple.trk tmp_trk2tck.tck -force -quiet
if ! cmp -s tmp_trk2tck.tck simple.tck; then
  testing_diff_tck tmp_trk2tck.tck simple.tck -distance 1e-4
fi

# Direction 2: simple.tck -> trk, compare to simple.trk (bridged through ".tck").
if ! cmp -s tmp_simple_out.trk simple.trk; then
  tckconvert tmp_simple_out.trk tmp_mine_dec.tck -force -quiet
  tckconvert simple.trk tmp_ref_dec.tck -force -quiet
  testing_diff_tck tmp_mine_dec.tck tmp_ref_dec.tck -distance 1e-4
fi
