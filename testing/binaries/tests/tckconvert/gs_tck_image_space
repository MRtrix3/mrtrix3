#!/bin/bash
# Reference-data validation (TRX_DATA_DIR, tee-ar-ex gold standard): transforming
#   "gs.tck" from world (RASMM) space into image (scanner-millimetre) space with
#   the "gs_3mm.nii" reference grid, then dumping to ASCII and concatenating, must
#   reproduce "gs_voxmm_space.txt". Image-mm coordinates are independent of voxel
#   size (they are mm measured along the image axes from its origin), so the 3 mm
#   reference grid suffices.
tckconvert gs.tck 'tmp_img-[].txt' -scanner2image gs_3mm.nii -force -quiet
cat $(ls tmp_img-*.txt | sort) > tmp_img_all.txt
testing_diff_matrix tmp_img_all.txt gs_voxmm_space.txt -abs 1e-4
