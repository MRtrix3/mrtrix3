#!/bin/bash
# "-insert" asserts that the nominated file IS the sidecar for the tractogram, so
#   any length mismatch is an ERROR (in contrast to the truncate-and-warn contract
#   that the bare "-tsf_in" / "-tck_weights_in" routes retain). Every mismatch is
#   diagnosed before the output is created, so no partial output is left behind.
set -e

# Fixtures: the 500-streamline tractogram with matching per-streamline (.csv) and
#   per-vertex (.tsf) sidecars, plus a 100-streamline truncation of each.
tckedit tracks.tck tmp_short.tck -number 100 -force -quiet
tcksample tracks.tck tcksample/fa.mif tmp_full.tsf -force -quiet
tcksample tmp_short.tck tcksample/fa.mif tmp_short.tsf -force -quiet
# A per-streamline SCALAR ".csv" is by convention a single comma-separated row
#   (what save_vector emits, and what the round trip below reproduces).
python3 -c "open('tmp_full.csv','w').write(','.join(str(0.5*i) for i in range(500))+'\n')"
python3 -c "open('tmp_short.csv','w').write(','.join(str(0.5*i) for i in range(100))+'\n')"

# Each mismatch combination is rejected, quoting the two counts, and writes nothing.
reject() {
  rm -f tmp_reject.trx
  ! tckconvert "$@" tmp_reject.trx -force -quiet 2> tmp_reject.err
  grep -q "entries" tmp_reject.err
  [ ! -e tmp_reject.trx ]
}
reject tracks.tck -insert dps weights tmp_short.csv    # per-streamline, too few
reject tracks.tck -insert dpv fa tmp_short.tsf         # per-vertex, too few
reject tmp_short.tck -insert dps weights tmp_full.csv  # per-streamline, too many
reject tmp_short.tck -insert dpv fa tmp_full.tsf       # per-vertex, too many

# The matched case is unaffected: both fields are embedded and recoverable.
tckconvert tracks.tck tmp_ok.trx -insert dps weights tmp_full.csv -insert dpv fa tmp_full.tsf -force -quiet
tckconvert tmp_ok.trx tmp_ok.tck -extract dps weights tmp_ok.csv -extract dpv fa tmp_ok.tsf -force -quiet
testing_diff_matrix tmp_ok.csv tmp_full.csv -abs 1e-4
testing_diff_tsf tmp_ok.tsf tmp_full.tsf -abs 1e-4 -noproperties
testing_diff_tck tmp_ok.tck tracks.tck -distance 1e-4
