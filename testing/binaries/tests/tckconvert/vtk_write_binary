#!/bin/bash
# Ensure that streamlines can be written to binary VTK format and read back losslessly.
# The .vtk format is served by the framework format handler; the binary encoding is
#   the default. A full-file byte comparison against legacy reference data is no longer
#   used because the handler now embeds the invoking command string in the VTK header
#   line (which varies between invocations); correctness is instead established by a
#   round-trip through the framework path.
tckconvert tracks.tck tmp.vtk -force -quiet
tckconvert tmp.vtk tmp.tck -force -quiet
testing_diff_tck tmp.tck tracks.tck
