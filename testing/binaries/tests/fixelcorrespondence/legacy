#!/bin/bash
# Evaluate > 3.1.0 version of the fixelcorrespondence command,
#   testing specifically the "legacy" matching algorithm
# Ensure that output matches that generated by the first working version of the revised command

# Session 1
fixelcorrespondence fixelcorrespondence/session1/fd.mif fixelcorrespondence/template/fd.mif tmp.npz \
    -algorithm legacy \
    -force

unzip fixelcorrespondence/mapping_legacy_s1.npz -d tmp_mapping_legacy_s1/
rm -rf tmp/
unzip tmp.npz -d tmp/

testing_diff_matrix tmp_mapping_legacy_s1/indices_forward.npy tmp/indices_forward.npy -abs 0
testing_diff_matrix tmp_mapping_legacy_s1/indptr_forward.npy tmp/indptr_forward.npy -abs 0
testing_diff_matrix tmp_mapping_legacy_s1/data_forward.npy tmp/data_forward.npy -abs 1e-5
testing_diff_matrix tmp_mapping_legacy_s1/indices_inverse.npy tmp/indices_inverse.npy -abs 0
testing_diff_matrix tmp_mapping_legacy_s1/indptr_inverse.npy tmp/indptr_inverse.npy -abs 0
testing_diff_matrix tmp_mapping_legacy_s1/data_inverse.npy tmp/data_inverse.npy -abs 1e-5

# Session 3
fixelcorrespondence fixelcorrespondence/session3/fd.mif fixelcorrespondence/template/fd.mif tmp.npz \
    -algorithm legacy \
    -force

unzip fixelcorrespondence/mapping_legacy_s3.npz -d tmp_mapping_legacy_s3/
rm -rf tmp/
unzip tmp.npz -d tmp/

testing_diff_matrix tmp_mapping_legacy_s3/indices_forward.npy tmp/indices_forward.npy -abs 0
testing_diff_matrix tmp_mapping_legacy_s3/indptr_forward.npy tmp/indptr_forward.npy -abs 0
testing_diff_matrix tmp_mapping_legacy_s3/data_forward.npy tmp/data_forward.npy -abs 1e-5
testing_diff_matrix tmp_mapping_legacy_s3/indices_inverse.npy tmp/indices_inverse.npy -abs 0
testing_diff_matrix tmp_mapping_legacy_s3/indptr_inverse.npy tmp/indptr_inverse.npy -abs 0
testing_diff_matrix tmp_mapping_legacy_s3/data_inverse.npy tmp/data_inverse.npy -abs 1e-5

