#!/bin/bash
# Single contrast registration; rigid only
# Outcome is compared against that generated by a prior version of the software
# REFERENCE: mrregister moving.mif.gz template.mif.gz \
#     -type rigid -rigid_niter 15 -transformed mrregister/rigid_out.mif.gz -force
mrregister moving.mif.gz template.mif.gz \
    -type rigid \
    -rigid_niter 15 \
    -transformed - | \
testing_diff_image - mrregister/rigid_out.mif.gz -abs 1e-5
