#!/bin/bash
# Single contrast affine registration with midway-space transformed output
# The midway space is the halfway point between the two image spaces;
#   both input images are transformed to this shared space
# Outcome is compared against that generated by a prior version of the software
# "moving.mif.gz" and "template.mif.gz" are shared with many other tests;
#   they are therefore downsampled here rather than in the test data itself,
#   as registration cost scales with the number of voxels
mrgrid moving.mif.gz regrid -scale 0.5 tmp-moving.mif -force
mrgrid template.mif.gz regrid -scale 0.5 tmp-template.mif -force

mrregister tmp-moving.mif tmp-template.mif \
    -type affine \
    -affine_niter 15 \
    -transformed_midway tmp_midway_moving.mif.gz tmp_midway_template.mif.gz \
    -force
testing_diff_image tmp_midway_moving.mif.gz mrregister/midway_moving.mif.gz -abs 1e-5
testing_diff_image tmp_midway_template.mif.gz mrregister/midway_template.mif.gz -abs 1e-5
