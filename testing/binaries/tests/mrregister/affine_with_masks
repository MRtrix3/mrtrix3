#!/bin/bash
# Single contrast affine registration with mask images constraining the metric
# Masks restrict the region of the image used to compute the registration cost function
# Outcome is compared against that generated by a prior version of the software
# REFERENCE: mrregister moving.mif.gz template.mif.gz \
#     -type affine -affine_niter 15 \
#     -mask1 moving.mif.gz -mask2 template.mif.gz \
#     -transformed mrregister/affine_masked_out.mif.gz -force
mrregister moving.mif.gz template.mif.gz \
    -type affine \
    -affine_niter 15 \
    -mask1 moving.mif.gz \
    -mask2 template.mif.gz \
    -transformed - | \
testing_diff_image - mrregister/affine_masked_out.mif.gz -abs 1e-5
