#!/bin/bash
# Single contrast registration; rigid then affine
# Outcome is compared against that generated by a prior version of the software
# REFERENCE: mrregister moving.mif.gz template.mif.gz \
#     -type rigid_affine -rigid_niter 10 -affine_niter 10 \
#     -transformed mrregister/rigid_affine_out.mif.gz -force
mrregister moving.mif.gz template.mif.gz \
    -type rigid_affine \
    -rigid_niter 10 \
    -affine_niter 10 \
    -transformed - | \
testing_diff_image - mrregister/rigid_affine_out.mif.gz -abs 1e-5
