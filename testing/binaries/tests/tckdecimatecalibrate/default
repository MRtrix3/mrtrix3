#!/bin/bash
# Verify operation of tckdecimatecalibrate:
#   sweep the fast decimator over two density values (mu) on a small synthetic
#   tractogram and check the reported Hausdorff-percentile table is well-formed.
# Build a tractogram of a few curved streamlines (straight run -> tight arc -> straight run);
#   the arc makes the spline non-trivial so that decimation incurs a measurable Hausdorff error.
#   Each streamline is emitted to its own numbered ASCII file and combined via tckconvert's
#   "[]" glob (the per-streamline ASCII format used by the sibling tckresample tests).
for s in 0 1 2; do
  awk -v s=$s 'BEGIN {
    pi = 3.14159265358979;
    r = 4.0 + s;
    for (i = 0; i < 25; ++i) printf "%.6f %.6f 0\n", i*15.0/24.0, 0.0;
    cx = 15.0; cy = r;
    for (i = 1; i <= 40; ++i) { a = -pi/2 + (pi/2)*i/40.0; printf "%.6f %.6f 0\n", cx+r*cos(a), cy+r*sin(a); }
    for (i = 1; i <= 25; ++i) printf "%.6f %.6f 0\n", 15.0+r, r+i*15.0/25.0;
  }' > "tmp-synth-000000${s}.txt"
done
tckconvert "tmp-synth-[].txt" tmp-tracks.tck -force

# Sweep two density values: a small mu (coarse decimation, larger error) and a
#   larger mu (finer decimation, smaller error). Write the machine-readable CSV.
tckdecimatecalibrate tmp-tracks.tck 0.05,0.2 -csv tmp-cal.csv -force

# CSV columns: mu,p50_mm,p75_mm,p95_mm,p99_mm,p99.9_mm,p100_mm,compression,count
# Strip the leading comment line and the header; keep the two data rows in order.
grep -v '^#' tmp-cal.csv | tail -n +2 > tmp-rows.csv

# Assert: exactly two data rows.
[ "$(grep -c . tmp-rows.csv)" -eq 2 ]

# Assert: within each mu row, the six percentile columns (fields 2..7) are non-decreasing.
awk -F, '{
  for (c = 3; c <= 7; ++c) {
    if ($c + 1e-6 < $(c-1)) { printf "percentiles not ordered in mu=%s (col %d)\n", $1, c; exit 1; }
  }
}' tmp-rows.csv

# Row 1 is the smaller mu (0.05), row 2 the larger (0.2), in input order.
small=$(sed -n '1p' tmp-rows.csv)
large=$(sed -n '2p' tmp-rows.csv)

# Assert: smaller mu yields error no smaller than larger mu at every percentile (fields 2..7).
echo "$small" | cut -d, -f2-7 | tr ',' ' ' > tmp-small.txt
echo "$large" | cut -d, -f2-7 | tr ',' ' ' > tmp-large.txt
paste -d' ' tmp-small.txt tmp-large.txt | awk '{
  for (i = 1; i <= 6; ++i) {
    s = $i; l = $(i+6);
    if (s + 1e-6 < l) { printf "smaller mu not monotone larger at percentile index %d (%s < %s)\n", i, s, l; exit 1; }
  }
}'

# Assert: the higher-density mu compresses less aggressively (compression nearer 1), i.e.
#   compression(small mu) <= compression(large mu). Field 8 is the compression ratio.
comp_small=$(echo "$small" | cut -d, -f8)
comp_large=$(echo "$large" | cut -d, -f8)
awk -v a="$comp_small" -v b="$comp_large" 'BEGIN { if (a > b + 1e-6) { print "compression not monotone"; exit 1; } }'
