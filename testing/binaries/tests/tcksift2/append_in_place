#!/bin/bash
# Appending a sidecar field to an EXISTING TRX dataset whose format supports
#   in-place augmentation (an uncompressed archive) does NOT require -force when
#   the field name is new: the weights are written as a new member without
#   rewriting the streamline data. The geometry is left untouched.
rm -rf tmp_a.trx tmp_a_rt.tck
tckconvert SIFT_phantom/tracks.tck tmp_a.trx -config TRXArchiveCompression store -force
tcksift2 SIFT_phantom/tracks.tck SIFT_phantom/fods.mif tmp_a.trx::myweights
tckconvert tmp_a.trx tmp_a_rt.tck -force
testing_diff_tck tmp_a_rt.tck SIFT_phantom/tracks.tck
