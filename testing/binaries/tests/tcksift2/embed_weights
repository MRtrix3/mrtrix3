#!/bin/bash
# Step 4: tcksift2 -out_tracks embeds the estimated per-streamline weights as the
#   reserved "weight" data-per-streamline field of an output tractogram.
# For the rewrite-only .tck format the command must:
#   (a) emit the fallback warning that a full rewrite was required;
#   (b) write the embedded weights to the out_weights sidecar, equal to the
#       weights produced by a plain (no -out_tracks) run;
#   (c) leave the streamline vertex data unchanged (no other data rewritten).
rm -rf tmp/ tmp_plain.csv tmp_embed.csv tmp_embed.tck tmp.txt

# Plain run: weights only.
tcksift2 SIFT_phantom/tracks.tck SIFT_phantom/fods.mif tmp_plain.csv -force

# Embedded run: same weights to a sidecar plus a weighted tractogram.
tcksift2 SIFT_phantom/tracks.tck SIFT_phantom/fods.mif tmp_embed.csv \
  -out_tracks tmp_embed.tck -force 2> tmp.txt
cat tmp.txt

# (a) the rewrite fallback warning must be present for .tck.
grep -i "does not support appending" tmp.txt

# (b) the embedded weights (out_weights sidecar) must equal the plain weights.
testing_diff_matrix tmp_plain.csv tmp_embed.csv -frac 1e-4

# (c) the rewritten tractogram must hold the same vertices as the input.
testing_diff_tck tmp_embed.tck SIFT_phantom/tracks.tck
