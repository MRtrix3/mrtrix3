#!/bin/bash
# Cross-group mutual-exclusion set (cross-group mutex violation class).
# tcksift2 declares MUTUALLY_EXCLUSIVE_OPTIONS = {-min_factor/-min_coeff, -max_factor/-max_coeff}.
#   These are alternative parameterisations of the same bound and only a subset of one option
#   group, so the exclusion is declared as a cross-group mutex set (group-structure independent).
#   Specifying both members of a set must fail at parse time (before any input is read), naming the
#   offending options; specifying one must not trigger the constraint.

MISSING_TCK=constraint_missing.tck
MISSING_FOD=constraint_missing.mif
OUT_TXT=constraint_missing_out.txt

# Both -max_factor and -max_coeff: must fail as mutually exclusive.
OUT=$(tcksift2 $MISSING_TCK $MISSING_FOD $OUT_TXT -max_factor 2 -max_coeff 3 2>&1) \
  && { echo "ERROR: expected mutex failure (max)"; exit 1; }
echo "$OUT" | grep -q "mutually exclusive; at most one may be specified"
echo "$OUT" | grep -q -- "-max_factor"
echo "$OUT" | grep -q -- "-max_coeff"

# Both -min_factor and -min_coeff: must also fail.
OUT=$(tcksift2 $MISSING_TCK $MISSING_FOD $OUT_TXT -min_factor 0.1 -min_coeff 0.2 2>&1) \
  && { echo "ERROR: expected mutex failure (min)"; exit 1; }
echo "$OUT" | grep -q "mutually exclusive; at most one may be specified"
echo "$OUT" | grep -q -- "-min_factor"

# A single member of a set (-max_factor): the mutex must NOT fire.
OUT=$(tcksift2 $MISSING_TCK $MISSING_FOD $OUT_TXT -max_factor 2 2>&1) && { echo "ERROR: expected later failure on missing input"; exit 1; }
echo "$OUT" | grep -q "mutually exclusive" && { echo "ERROR: mutex fired for a single option"; exit 1; }
true
