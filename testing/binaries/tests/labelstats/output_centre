#!/bin/bash
# Verify the -output centre option of labelstats
# When requesting only the centre-of-mass field in scanner space,
#   the output should be a matrix with 3 columns (x, y, z coordinates);
#   compare to a reference generated by a prior software version
# Ensure that output matches that generated by a prior software version
# REFERENCE: Run this on a stable version:
#   labelstats labelconvert/out_aal.mif.gz -output centre > labelstats/centre.txt;
#   cp labelstats/centre.txt labelstats/

labelstats labelconvert/out_aal.mif.gz -output centre > tmp.txt
testing_diff_matrix tmp.txt labelstats/centre.txt -abs 1e-4
