#!/bin/bash
# Verify the -output mass option of labelstats
# When requesting only the mass (voxel count) field,
#   the output should be a column vector of positive integers;
#   compare to a reference generated by a prior software version
# Ensure that output matches that generated by a prior software version
# REFERENCE: Run this on a stable version:
#   labelstats labelconvert/out_aal.mif.gz -output mass > labelstats/mass.txt;
#   cp labelstats/mass.txt labelstats/

labelstats labelconvert/out_aal.mif.gz -output mass > tmp.txt
testing_diff_matrix tmp.txt labelstats/mass.txt -abs 0
