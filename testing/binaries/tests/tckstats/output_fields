#!/bin/bash
# Verify the -output option of "tckstats",
#   which selects specific fields for machine-readable output.
# The count field must equal the number of streamlines in the file
#   (as confirmed via tckinfo).

rm -f tmp_count.txt tmp_minmax.txt
tckstats tracks.tck -output count > tmp_count.txt
tckstats tracks.tck -output min -output max > tmp_minmax.txt

# count output is a single positive integer
count=$(cat tmp_count.txt | tr -d '[:space:]')
[ "$count" -gt 0 ]

# min-max output contains two values on a single line
word_count=$(wc -w < tmp_minmax.txt)
[ "$word_count" -eq 2 ]
