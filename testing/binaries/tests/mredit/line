#!/bin/bash
# Verify the -line option (a cylinder with hemispherical caps).
# mask.mif is a 6x8x9 image with 2.5mm voxels;
#   a line of radius 1.5mm is drawn between voxels (1,4,4) and (5,4,4)
#   and filled with value 1.
# The output is compared against a reference image
#   that has been manually verified to be correct
#   and committed to the test_data repository.
#
# To (re)generate the reference image mredit/line.mif:
#   1. From the root of the test_data repository, run:
#        mrconvert mask.mif -datatype uint8 - | \
#        mredit - -line 1,4,4 5,4,4 1.5 1.0 mredit/line.mif -force
#   2. Manually verify that the result is correct (e.g. using mrview).
#   3. Commit mredit/line.mif to the test_data repository
#        on the branch matching the target source-code branch.

mrconvert mask.mif -datatype uint8 - | \
mredit - -line 1,4,4 5,4,4 1.5 1.0 - | \
testing_diff_image - mredit/line.mif -abs 0
