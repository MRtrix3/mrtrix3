#!/bin/bash
# Verify fixel2fixel command under usage:
# - POT fixel-fixel correspondence algorithm
# - Metric is cosine angle between template fixel and reconstructed subject fixel
#   (the FD metric is additionally provided via the -weighted option
#   to better inform the reconstruction of fixels from multiple input subject fixels with different volumes)
# Ensure that output matches that generated by the fixel2fixel command
#   after addition of the Partial Optimal Transport matching algorithm to fixelcorrespondence

rm -rf tmp/
mkdir tmp/
cp fixel2fixel/directions.mif tmp/
cp fixel2fixel/index.mif tmp/

fixel2fixel fixelcorrespondence/session1/fd.mif fixelcorrespondence/mapping_pot_s1.npz angle tmp/ angle_s1.mif \
    -weighted fixelcorrespondence/session1/fd.mif
fixel2fixel fixelcorrespondence/session3/fd.mif fixelcorrespondence/mapping_pot_s3.npz angle tmp/ angle_s3.mif \
    -weighted fixelcorrespondence/session3/fd.mif

testing_diff_image tmp/angle_s1.mif fixel2fixel/angle_pot_s1.mif -abs 1e-5
testing_diff_image tmp/angle_s3.mif fixel2fixel/angle_pot_s3.mif -abs 1e-5
