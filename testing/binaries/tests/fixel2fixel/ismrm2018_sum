#!/bin/bash
# Verify fixel2fixel command under usage:
# - ISMRM2018 fixel-fixel correspondence algorithm
# - Summing values across multiple input fixels contributing to one output fixel
#   (which is the suitable aggregation for an additive fibre density metric)
# Ensure that output matches that generated by the first working version of the fixel2fixel command
#  specifically before the utilisation of AI to complete #2688,
#  including the transition of representing the mapping from a directory of .mif images to a single .npz file:
#  9018cdb62cfafd05678d3bb9b3fa5e3e442e9847

rm -rf tmp/
mkdir tmp/
cp fixel2fixel/directions.mif tmp/
cp fixel2fixel/index.mif tmp/

fixel2fixel fixelcorrespondence/session1/fd.mif fixelcorrespondence/mapping_ismrm2018_s1.npz sum tmp/ fdsum_s1.mif
fixel2fixel fixelcorrespondence/session3/fd.mif fixelcorrespondence/mapping_ismrm2018_s3.npz sum tmp/ fdsum_s3.mif

testing_diff_image tmp/fdsum_s1.mif fixel2fixel/fdsum_ismrm2018_s1.mif -frac 1e-5
testing_diff_image tmp/fdsum_s3.mif fixel2fixel/fdsum_ismrm2018_s3.mif -frac 1e-5
