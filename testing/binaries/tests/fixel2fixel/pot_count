#!/bin/bash
# Verify fixel2fixel command under usage:
# - POT fixel-fixel correspondence algorithm
# - Counting the number of subject fixels contributing to each template fixel
# Ensure that output matches that generated by the fixel2fixel command
#   after addition of the Partial Optimal Transport algorithm to the fixelcorrespondence command

rm -rf tmp/
mkdir tmp/
cp fixel2fixel/directions.mif tmp/
cp fixel2fixel/index.mif tmp/

fixel2fixel fixelcorrespondence/session1/fd.mif fixelcorrespondence/mapping_pot_s1.npz count tmp/ count_s1.mif
fixel2fixel fixelcorrespondence/session3/fd.mif fixelcorrespondence/mapping_pot_s3.npz count tmp/ count_s3.mif

testing_diff_image tmp/count_s1.mif fixel2fixel/count_pot_s1.mif -abs 0
testing_diff_image tmp/count_s3.mif fixel2fixel/count_pot_s3.mif -abs 0
