#!/bin/bash
# Verify fixel2fixel command under usage:
# - POT fixel-fixel correspondence algorithm
# - Summing values across multiple input fixels contributing to one output fixel
#   (which is the suitable aggregation for an additive fibre density metric)
# Ensure that output matches that generated by the fixel2fixel command
#   generated immediately after addition of the Partial Optimal Transport algorithm to the fixelcorrespondence command

rm -rf tmp/
mkdir tmp/
cp fixel2fixel/directions.mif tmp/
cp fixel2fixel/index.mif tmp/

fixel2fixel fixelcorrespondence/session1/fd.mif fixelcorrespondence/mapping_pot_s1.npz sum tmp/ fdsum_s1.mif
fixel2fixel fixelcorrespondence/session3/fd.mif fixelcorrespondence/mapping_pot_s3.npz sum tmp/ fdsum_s3.mif

testing_diff_image tmp/fdsum_s1.mif fixel2fixel/fdsum_pot_s1.mif -frac 1e-5
testing_diff_image tmp/fdsum_s3.mif fixel2fixel/fdsum_pot_s3.mif -frac 1e-5
