#!/bin/bash
# Verify fixel2fixel command under usage:
# - Legacy fixel-fixel correspondence algorithm
# - Tracking the FD value from subject fixels
#   Note that unlike the combinatorial fixel-fixel mapping algorithms,
#   for the legacy matching process there is no difference between "mean" and "sum" aggregation modes in fixel2fixel,
#   given it is not possible for more than one subject fixel to contribute to a template fixel
#   This test therefore ensures that those two operations yield the same result
# Ensure that output matches that generated by the 3.1.0 version of the fixelconnectivity command

rm -rf tmp/
mkdir tmp/
cp fixel2fixel/directions.mif tmp/
cp fixel2fixel/index.mif tmp/

fixel2fixel fixelcorrespondence/session1/fd.mif fixelcorrespondence/mapping_legacy_s1.npz mean tmp/ fdmean_s1.mif
fixel2fixel fixelcorrespondence/session1/fd.mif fixelcorrespondence/mapping_legacy_s1.npz sum tmp/ fdsum_s1.mif
fixel2fixel fixelcorrespondence/session3/fd.mif fixelcorrespondence/mapping_legacy_s3.npz mean tmp/ fdmean_s3.mif
fixel2fixel fixelcorrespondence/session3/fd.mif fixelcorrespondence/mapping_legacy_s3.npz sum tmp/ fdsum_s3.mif

testing_diff_image tmp/fdmean_s1.mif tmp/fdsum_s1.mif -abs 0
testing_diff_image tmp/fdmean_s3.mif tmp/fdsum_s3.mif -abs 0

testing_diff_image tmp/fdsum_s1.mif fixel2fixel/fd_legacy_s1.mif -frac 1e-5
testing_diff_image tmp/fdsum_s3.mif fixel2fixel/fd_legacy_s3.mif -frac 1e-5
