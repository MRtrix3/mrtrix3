#!/bin/bash
# Group constraint require_at_least_one() (at-least-one violation class).
# warp2metric's output options (-fc / -jmat / -jdet) form a group constrained
#   require_at_least_one(): specifying none must fail at parse time naming the required options.
#   Specifying one satisfies the constraint (the command then fails only on the missing input).

MISSING_WARP=constraint_missing.mif
OUT_MIF=constraint_missing_out.mif

# No output option: must fail requiring at least one.
OUT=$(warp2metric $MISSING_WARP 2>&1) && { echo "ERROR: expected at-least-one failure"; exit 1; }
echo "$OUT" | grep -q "at least one of the following options must be specified"
echo "$OUT" | grep -q -- "-jdet"

# One output option (-jdet): the at-least-one constraint must NOT fire.
OUT=$(warp2metric $MISSING_WARP -jdet $OUT_MIF 2>&1) && { echo "ERROR: expected later failure on missing input"; exit 1; }
echo "$OUT" | grep -q "at least one of the following options" && { echo "ERROR: constraint fired when an output was given"; exit 1; }
true
