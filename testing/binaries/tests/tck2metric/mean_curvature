#!/bin/bash
# Verify the -mean_curvature option of "tck2metric",
#   which writes the per-streamline mean curvature to a vector file.
# The number of values written must equal the streamline count in the input tractogram.

rm -f tmp_curv.txt
tck2metric tracks.tck -mean_curvature tmp_curv.txt
streamline_count=$(tckinfo tracks.tck -count 2>&1 | grep "actual count in file:" | awk '{print $NF}')
curv_count=$(tail -n1 tmp_curv.txt | wc -w)
(( curv_count == streamline_count ))
