#!/bin/bash
# Test default operation of amp2response:
#   estimate a response function from DWI amplitudes
#   using the single-fibre voxel mask and eigenvector directions
#   from the sh2response test data.
# The command is run with default parameters and the result is compared
#   against a reference generated by a prior software version.
#
amp2response dwi.mif sh2response/sf.mif sh2response/ev.mif tmp.txt -force
testing_diff_matrix tmp.txt amp2response/default.txt -frac 1e-5
