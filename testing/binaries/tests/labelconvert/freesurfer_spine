#!/bin/bash
# Verify operation of the -spine option in labelconvert,
#   which assigns voxels within a provided segmentation mask to the
#   "Spinal_column" node index defined in the output lookup table
# A minimal output LUT containing the "Spinal_column" entry is created on-the-fly

# Construct a minimal output LUT that includes the Spinal_column entry
cat > tmp_lut_out.txt << 'EOF'
0     Unknown
1     ctx-lh-bankssts
2     Spinal_column
EOF

# Run labelconvert with -spine option;
#   mask.mif is used as the spine segmentation
# The test verifies the command completes without error
labelconvert labelconvert/in_fs.mif.gz labelconvert/FreeSurferColorLUT.txt \
  tmp_lut_out.txt tmp_spine_out.mif -spine mask.mif -force
