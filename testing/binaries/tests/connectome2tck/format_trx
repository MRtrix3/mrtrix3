#!/bin/bash
# The -file_format option selects the per-node / per-edge output tractogram format.
# An embed-capable format (.trx) carries the streamlines (and would embed weights /
#   per-vertex data); here we verify the command writes the expected .trx files and
#   that each round-trips back to the input streamline geometry (via tckconvert),
#   comparing against the .tck references produced by the per_node test.
rm -rf tmp/ tmp_1.tck tmp_3.tck
connectome2tck SIFT_phantom/tracks.tck tck2connectome/assignments.csv tmp/ \
  -nodes 1,3 -files per_node -file_format trx -force
test -f tmp/1.trx
test -f tmp/3.trx
tckconvert tmp/1.trx tmp_1.tck -force
tckconvert tmp/3.trx tmp_3.tck -force
testing_diff_tck tmp_1.tck connectome2tck/nodes1.tck
testing_diff_tck tmp_3.tck connectome2tck/nodes3.tck
