#!/bin/bash
# Test extracting streamlines grouped by node
#   using the -files per_node option for a limited set of nodes.
# The assignments file is the reference output from the tck2connectome test.
# The test verifies that the files match those
#   generated by an earlier version of the command,
#   and that there are no unexpected files.

rm -rf tmp/
connectome2tck SIFT_phantom/tracks.tck tck2connectome/assignments.csv tmp/ \
    -nodes 1,3 \
    -files per_node \
    -force

testing_diff_tck tmp/1.tck connectome2tck/nodes1.tck
testing_diff_tck tmp/3.tck connectome2tck/nodes3.tck

FILECOUNT=$(ls tmp/ | \
            wc -l)
[[ ${FILECOUNT} -eq "2" ]]
