#!/bin/bash
# Step 6: connectome2tck carries per-streamline weights (dps) AND per-vertex
#   (dpv, a .tsf) sidecar data through to the extracted per-edge tractograms.
# Sample a per-vertex .tsf and manufacture a per-streamline weights file, extract
#   per-node track files carrying both, then confirm that for each output file the
#   .tsf is consistent with its .tck (per-streamline vertex counts match) and that
#   a matching per-edge weights file was produced.
rm -rf tmp_tck/ tmp_tsf/ tmp_w/
tcksample SIFT_phantom/tracks.tck SIFT_phantom/mask.mif tmp_in.tsf -force

# One weight per streamline.
N=$(tckinfo SIFT_phantom/tracks.tck -count 2>/dev/null | grep -iE "actual count" | grep -oE "[0-9]+" | head -n1)
rm -f tmp_w.txt
i=0
while [ "$i" -lt "$N" ]; do echo "3" >> tmp_w.txt; i=$((i+1)); done

connectome2tck SIFT_phantom/tracks.tck tck2connectome/assignments.csv tmp_tck/ \
  -nodes 1,3 -files per_node \
  -tsf_in tmp_in.tsf -tsf_out tmp_tsf/ \
  -tck_weights_in tmp_w.txt -tck_weights_out tmp_w/ -force

# For each extracted node file, the .tsf must be consistent with the .tck, and a
#   per-node weights file must exist (and be non-empty).
for node in 1 3; do
  test -f tmp_tck/${node}.tck
  test -f tmp_tsf/${node}.tsf
  test -s tmp_w/${node}.csv
  tsfvalidate tmp_tsf/${node}.tsf tmp_tck/${node}.tck
  # Every extracted streamline had weight 3, so the per-node weights are all 3
  #   (standard MRtrix vector file: "# " comment header then comma/space values).
  grep -v '^#' tmp_w/${node}.csv | tr ' \t,' '\n\n\n' | grep -E '[0-9]' > tmp_tok.txt
  ! grep -vqE '^3$' tmp_tok.txt
done
