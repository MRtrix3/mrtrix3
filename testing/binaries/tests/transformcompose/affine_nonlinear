#!/bin/bash
# Verify operation composing an affine and nonlinear transformation
# Outcome is compared to that generated using a prior software version
# NOTE: transformcompose now interpolates the input warp through the imputation-aware cubic
#   Interp::Warp rather than Interp::Linear. Reference data may legitimately change near the
#   warp's field-of-view boundary, where positions outside the valid region (interpolated
#   finite-input mask < 0.5) are now NaN-filled instead of clamp-extrapolated; interior values
#   of an affine/identity warp are reproduced exactly by both and should be unchanged.
transformcompose rotatez.txt unit_warp.mif - | \
testing_diff_image - transformcompose/out2.mif -frac 0.001
