#!/bin/bash
# Verify operation when all FMLS segmentation thresholds are disabled
#   (this produces a much larger number of fixels per voxel)
# Ensure that output matches that generated by a prior software version
rm -rf tmp/

fod2fixel -nthreads 1 fod.mif tmp/ \
-fmls_no_thresholds \
-afd afd.mif \
-peak peak.mif \
-disp disp.mif \
-skew skew.mif \
-force

# The unconditionally-exported dixel-mask file is absent from the legacy reference directory;
#   remove it so the whole-directory comparison is not perturbed
rm -f tmp/dixelmasks.mif

testing_diff_fixel -frac 10e-5 tmp/ fod2fixel/out3
